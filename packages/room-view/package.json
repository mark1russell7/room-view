{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/room-view",
  "version": "0.2.1",
  "description": "A room as data, and its 3D model from that data: walls with openings, floors, outlets, circuits and placed objects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/room-view.git",
    "directory": "packages/room-view"
  },
  "homepage": "https://mark1russell7.github.io/room-view/",
  "bugs": {
    "url": "https://github.com/mark1russell7/room-view/issues"
  },
  "keywords": [
    "room",
    "floor-plan",
    "3d",
    "three",
    "gltf",
    "homelab",
    "circuits",
    "outlets"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./sample": "./src/sample.ts",
    "./three": "./src/three.ts",
    "./marks": "./src/marks.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/layout-contract": "^0.10.2",
    "@mark1russell7/quantity": "^0.4.1",
    "@mark1russell7/visuals": "^0.3.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "three": ">=0.187.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "three": "^0.187.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./schema": {
        "types": "./build/schema.d.ts",
        "import": "./build/schema.js",
        "default": "./build/schema.js"
      },
      "./sample": {
        "types": "./build/sample.d.ts",
        "import": "./build/sample.js",
        "default": "./build/sample.js"
      },
      "./three": {
        "types": "./build/three.d.ts",
        "import": "./build/three.js",
        "default": "./build/three.js"
      },
      "./marks": {
        "types": "./build/marks.d.ts",
        "import": "./build/marks.js",
        "default": "./build/marks.js"
      },
      "./package.json": "./package.json"
    }
  }
}
