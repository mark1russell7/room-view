{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/electrical",
  "version": "0.1.0",
  "description": "Electrical circuits as data: outlets, circuits, feeds and loads, the continuous-load check, and the circuit formulas as Vex programs. An add-on of room-view.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/room-view.git",
    "directory": "packages/electrical"
  },
  "homepage": "https://mark1russell7.github.io/room-view/",
  "bugs": {
    "url": "https://github.com/mark1russell7/room-view/issues"
  },
  "keywords": [
    "electrical",
    "circuits",
    "breakers",
    "outlets",
    "loads",
    "continuous-load",
    "room",
    "vex"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/room-view": "workspace:*",
    "@mark1russell7/vex": "^0.19.1",
    "@mark1russell7/vex-domains": "^0.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
