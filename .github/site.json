{
  "$comment": "The site config of this repository (CI.md of the template, \"The site config\"). The Pages workflow deploys this site from main, and a job of ci.yml checks it on each pull request.",
  "build": "pnpm --filter @room-view/site run build",
  "out": "packages/site/dist",
  "env": {
    "SITE_BASE": "/{repo}"
  },
  "packages": "@mark1russell7/room-view,@mark1russell7/electrical",
  "site-name": "room-view",
  "roadmap": "docs/ROADMAP.md",
  "site-check": true,
  "site-check-pages": "/,/measure/,/releases/,/status/",
  "site-check-probe": "packages/site/src/site.probe.ts,/measure/=packages/site/src/measure.probe.ts"
}
